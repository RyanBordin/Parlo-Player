{
  // Generated by SvelteKit (see node_modules/$app/tsconfig.json).
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  "include": ["src", "*"],
  "exclude": [
    // Built by Rust/Tauri, not part of the web app.
    "src-tauri",
    // Paraglide's SSR middleware needs Node types; this SPA never imports it.
    "src/lib/paraglide/server.js"
  ]
}
